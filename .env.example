# Copiá este archivo como .env y completá los valores. En Cloud Run, pasalos como variables
# de entorno o secretos del servicio (gcloud run deploy ... --set-env-vars / --set-secrets).
MONGODB_URI=mongodb+srv://USUARIO:CONTRASEÑA@cluster0.xxxxx.mongodb.net/
SECRET_KEY=una-clave-larga-y-aleatoria
# 1 en producción detrás de HTTPS (cookie de sesión solo por HTTPS); 0 en local
COOKIE_SECURE=0
# Bucket público con las imágenes de cada selección (<tipo>/<paises.nombre>.png); opcional
IMAGENES_PAISES_URL=https://storage.googleapis.com/com-icg-mundial
# La foto del partido (Vertex AI). Opcionales: estos son los valores por defecto
GCP_PROJECT=soy-radius-332400
VERTEX_LOCATION=global
VERTEX_MODELO_IMAGEN=gemini-3.1-flash-image
FOTOS_TAMANO=512
FOTOS_BUCKET=com-icg-mundial
FOTOS_POR_DIA=3
FOTOS_ZONA_HORARIA=America/Mexico_City
# El pulso: clave que manda Cloud Scheduler en X-Pulso-Clave (generala larga y aleatoria) y pulso local para desarrollo
PULSO_CLAVE=3ef6c159deeeb1d4d1f8bc62cebcf353233fd8d889a222ceeb5bdadf9e0171d3
PULSO_LOCAL=0
PULSO_INTERVALO_MIN=30
