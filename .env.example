# Copiá este archivo como .env y completá los valores. En Cloud Run, pasalos como variables
# de entorno o secretos del servicio (gcloud run deploy ... --set-env-vars / --set-secrets).
MONGODB_URI=mongodb+srv://USUARIO:CONTRASEÑA@cluster0.xxxxx.mongodb.net/
SECRET_KEY=una-clave-larga-y-aleatoria
# 1 en producción detrás de HTTPS (cookie de sesión solo por HTTPS); 0 en local
COOKIE_SECURE=0
